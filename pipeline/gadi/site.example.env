# Site settings of the HPC jobs in pipeline/gadi/ (PBS on NCI Gadi). Copy to pipeline/gadi/site.env
# (git-ignored) and fill in your project and paths; stage_and_submit.sh reads it, and the qsub-submitted
# jobs (mars/cells_job.sh) take the same variables through `qsub -v`.
DUNE_ATLAS_PROJECT=<project>                                   # #PBS -P
DUNE_ATLAS_STORAGE=gdata/<project>+gdata/xp65+scratch/<project>  # #PBS -l storage=
DUNE_ATLAS_PYTHON=/g/data/<project>/<user>/apps/dune_atlas_venv/bin/python
DUNE_ATLAS_WORK=/scratch/<project>/<user>/dune-atlas           # work, logs and stores (<work>/mars/...)
DUNE_ATLAS_MARS_DEM=<path to Mars_HRSC_MOLA_BlendDEM_Global_200mp_v2.tif>
