#!/bin/bash
# Mars terrain pilot: sample terrarium tiles z4-z8 from the MOLA–HRSC DEM (read in place), sizes + timings.
#PBS -P @PROJECT@
#PBS -q normal
#PBS -N mars_terrain_pilot
#PBS -l ncpus=12
#PBS -l mem=47GB
#PBS -l walltime=02:00:00
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOGS@/terrain_pilot.log
set -eu
PY=@PYTHON@
export DUNE_ATLAS_MARS_DEM=@MARS_DEM@
CODE=@CODE@
WORK=@WORK@/terrain/pilot
test -x $PY || { echo "no interpreter"; exit 127; }
test -f $CODE/dune_atlas_pipeline/mars/terrain.py || { echo "no code"; exit 3; }
mkdir -p $WORK
export PYTHONPATH=$CODE OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cd $WORK
echo "start $(date -u +%FT%TZ) host $(hostname)"
$PY -u -m dune_atlas_pipeline.mars.terrain pilot --out $WORK --workers 12 > $WORK/pilot_stdout.json
echo "DONE $(date -u +%FT%TZ)"
