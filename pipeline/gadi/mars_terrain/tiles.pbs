#!/bin/bash
# Mars terrain: full terrarium PMTiles z0-@MAXZOOM@ (+ z0-5 subset) from the MOLA–HRSC DEM (read in place).
#PBS -P @PROJECT@
#PBS -q normal
#PBS -N mars_terrain_tiles
#PBS -l ncpus=@NCPUS@
#PBS -l mem=@MEM@
#PBS -l walltime=@WALL@
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOGS@/terrain_tiles.log
set -eu
PY=@PYTHON@
export DUNE_ATLAS_MARS_DEM=@MARS_DEM@
CODE=@CODE@
WORK=@WORK@/terrain/tiles
STORES=@STORES@
test -x $PY || { echo "no interpreter"; exit 127; }
test -f $CODE/dune_atlas_pipeline/mars/terrain.py || { echo "no code"; exit 3; }
mkdir -p $WORK/tmp $STORES/basemaps
export PYTHONPATH=$CODE OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 TMPDIR=$WORK/tmp
cd $WORK
echo "start $(date -u +%FT%TZ) host $(hostname)"
$PY -u -m dune_atlas_pipeline.mars.terrain tiles --work $WORK --workers @WORKERS@ --maxzoom @MAXZOOM@ \
  --out $STORES/basemaps/hrsc-mola-terrarium.pmtiles --low-out $WORK/hrsc-mola-terrarium-z0-5.pmtiles > $WORK/tiles_stdout.json
echo "DONE $(date -u +%FT%TZ)"
