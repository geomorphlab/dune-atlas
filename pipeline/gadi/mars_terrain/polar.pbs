#!/bin/bash
# Mars terrain: polar-cap DEM textures (AEQD, N/S, 4096..256 px, terrarium lossless WebP) for the globe
# hillshade cap, from the MOLA–HRSC DEM (read in place).
#PBS -P @PROJECT@
#PBS -q normal
#PBS -N mars_terrain_polar
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOGS@/terrain_polar.log
set -eu
PY=@PYTHON@
export DUNE_ATLAS_MARS_DEM=@MARS_DEM@
CODE=@CODE@
OUT=@STORES@/basemaps/hrsc-mola-polar
test -x $PY || { echo "no interpreter"; exit 127; }
test -f $CODE/dune_atlas_pipeline/mars/terrain_polar.py || { echo "no code"; exit 3; }
export PYTHONPATH=$CODE OMP_NUM_THREADS=4
mkdir -p $OUT
echo "start $(date -u +%FT%TZ)"
$PY -u -m dune_atlas_pipeline.mars.terrain_polar --out $OUT > $OUT/../hrsc-mola-polar_stdout.json
echo "DONE $(date -u +%FT%TZ)"
