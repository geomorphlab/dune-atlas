#!/bin/bash
# Mars terrain: read back the terrarium PMTiles (full + z0-5 subset): header, per-zoom counts, decoded z8 tiles
# vs independent bilinear DEM samples, parent = 2x2 mean of children.
#PBS -P @PROJECT@
#PBS -q normal
#PBS -N mars_terrain_check
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOGS@/terrain_check.log
set -eu
PY=@PYTHON@
export DUNE_ATLAS_MARS_DEM=@MARS_DEM@
CODE=@CODE@
WORK=@WORK@/terrain/tiles
STORES=@STORES@
test -x $PY || { echo "no interpreter"; exit 127; }
export PYTHONPATH=$CODE
cd $WORK
$PY -u -m dune_atlas_pipeline.mars.terrain check --pmtiles $STORES/basemaps/hrsc-mola-terrarium.pmtiles --n-tiles 100 > $WORK/check_full.json
$PY -u -m dune_atlas_pipeline.mars.terrain check --pmtiles $WORK/hrsc-mola-terrarium-z0-5.pmtiles --no-dem > $WORK/check_low.json
echo DONE
