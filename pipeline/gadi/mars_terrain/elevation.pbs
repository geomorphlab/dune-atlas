#!/bin/bash
# Mars terrain: 1/64-degree area-mean elevation grid -> fields/elevation.zarr (GeoZarr native pyramid) + elev_mean npz.
#PBS -P @PROJECT@
#PBS -q normal
#PBS -N mars_terrain_elev
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=04:00:00
#PBS -l storage=@STORAGE@
#PBS -j oe
#PBS -o @LOGS@/terrain_elevation.log
set -eu
PY=@PYTHON@
export DUNE_ATLAS_MARS_DEM=@MARS_DEM@
CODE=@CODE@
WORK=@WORK@/terrain/elevation
STORES=@STORES@
test -x $PY || { echo "no interpreter"; exit 127; }
test -f $CODE/dune_atlas_pipeline/mars/terrain.py || { echo "no code"; exit 3; }
mkdir -p $WORK $STORES/fields
export PYTHONPATH=$CODE OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
cd $WORK
echo "start $(date -u +%FT%TZ) host $(hostname)"
rm -rf $STORES/fields/elevation.zarr.tmp
$PY -u -m dune_atlas_pipeline.mars.terrain elevation --work $WORK --store $STORES/fields/elevation.zarr.tmp \
  --npz $WORK/elev_mean.npz > $WORK/elevation_stdout.json
rm -rf $STORES/fields/elevation.zarr && mv $STORES/fields/elevation.zarr.tmp $STORES/fields/elevation.zarr
echo "DONE $(date -u +%FT%TZ)"
