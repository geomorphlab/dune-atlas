{
  "name": "dune-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "validate-registry": "vite-node scripts/validate-registry.ts",
    "check-cell-query": "vite-node scripts/check-cell-query.ts --",
    "check-decode": "node scripts/check-decode.mjs",
    "postinstall": "patch-package",
    "check-netcdf": "vite-node scripts/write-cell-exports.ts -- ../staging/fixture ../staging/check-netcdf && PYTHONPATH=../pipeline/src python scripts/check-netcdf.py ../staging/fixture ../staging/check-netcdf && vite-node scripts/write-cell-exports.ts -- ../staging/fixture/datasets/era5 ../staging/check-netcdf-era5 && PYTHONPATH=../pipeline/src python scripts/check-netcdf.py ../staging/fixture/datasets/era5 ../staging/check-netcdf-era5",
    "help-doc": "vite-node scripts/write-help-doc.ts"
  },
  "dependencies": {
    "@carbonplan/zarr-layer": "0.4.3",
    "@geomatico/maplibre-cog-protocol": "^0.10.0",
    "js-yaml": "^4",
    "katex": "^0.16.47",
    "maplibre-gl": "^5",
    "pmtiles": "^4",
    "zarrita": "^0.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/geojson": "^7946.0.16",
    "@types/js-yaml": "^4",
    "@types/node": "^22.20.5",
    "ajv": "^8",
    "happy-dom": "^20.14.6",
    "patch-package": "^8.0.1",
    "typescript": "^5",
    "vite": "^7",
    "vite-node": "^3",
    "vitest": "^3"
  }
}
